# YouTube Stream Ingestion Configuration
# Copy this file to stream.env or set environment variables in your runner/Docker host.

# YouTube Live RTMPS Endpoint & Key
YOUTUBE_STREAM_URL=rtmps://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=your_youtube_stream_key_here

# Stream Profile & Encoding Parameters (Profiles: 1080p | 720p)
STREAM_PROFILE=1080p
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_BITRATE=10M
AUDIO_BITRATE=128k
KEYFRAME_INTERVAL=2

# Video Library & Playlist Settings
PLAYLIST_FILE=config/playlist.txt
VIDEO_DIR=videos
PLAYLIST_MODE=sequential

# Schedule & Timezone Settings (Schedule: 22:00 IST start)
TIMEZONE=Asia/Kolkata
START_TIME=22:00
STOP_TIME=06:00

# Connection Retry & Resiliency Settings
MAX_RECONNECT_ATTEMPTS=10
RECONNECT_DELAY_SEC=5
MAX_RECONNECT_DELAY_SEC=60

# Developer & Testing Overrides
TEST_MODE=false
TEST_DURATION=300
DRY_RUN=false

# Optional Notifications (Discord Webhook / Telegram Bot)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
